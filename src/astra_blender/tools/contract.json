{
 "version": 1,
 "about": "The parallel-development contract for Astra 0.4. 'tools' lists every planned tool with the arguments fixes, recipes and prompts may rely on: names, types, enums and which are required. It is deliberately partial - a tool may accept more - and conservative - a caller that passes every pinned required argument is valid against the real tool. registry.contract_problems checks a registered spec against its entry; registry.check_args validates a planned call against the registered schema or, until the owner lands, against this entry. 'events' pins the run event payloads (docs/events.md).",
 "tier_names": [
  "small",
  "medium",
  "large"
 ],
 "stage_names": [
  "plan",
  "layout",
  "look",
  "motion",
  "review",
  "refine",
  "finalize"
 ],
 "upstream_readonly": [
  "get_object_info",
  "get_scene_info",
  "get_viewport_screenshot"
 ],
 "tools": {
